{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "publicHost": { "type": "string", "pattern": "^[^/\\s]*$" },
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string", "minLength": 1 } },
            "required": ["name"]
          }
        }
      }
    },
    "keypair": {
      "type": "object",
      "required": ["secretName"],
      "properties": {
        "secretName": { "type": "string", "minLength": 1 },
        "privateKeyKey": { "type": "string" },
        "publicKeyKey": { "type": "string" }
      }
    },
    "hbbs": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "command": { "type": "array", "items": { "type": "string" } },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 32 },
        "env": { "type": "object" },
        "oauth2": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" }
          }
        },
        "resources": { "$ref": "#/$defs/resources" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "affinity": { "type": "object" },
        "tolerations": { "type": "array" },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClass": { "type": "string" },
            "accessModes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"]
              }
            }
          }
        }
      }
    },
    "hbbr": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "command": { "type": "array", "items": { "type": "string" } },
        "replicas": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "env": { "type": "object" },
        "resources": { "$ref": "#/$defs/resources" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "affinity": { "type": "object" },
        "tolerations": { "type": "array" }
      }
    },
    "webclient": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "nginx": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workerConnections": { "type": "integer", "minimum": 512 }
          }
        },
        "env": { "type": "object" },
        "resources": { "$ref": "#/$defs/resources" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "affinity": { "type": "object" },
        "tolerations": { "type": "array" }
      }
    },
    "oidcMock": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "authorizeUrl": { "type": "string" },
        "image": { "$ref": "#/$defs/image" },
        "port": { "type": "integer" },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sub", "email", "name"],
            "properties": {
              "sub": { "type": "string" },
              "email": { "type": "string" },
              "name": { "type": "string" },
              "password": { "type": "string" }
            }
          }
        },
        "resources": { "$ref": "#/$defs/resources" }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        }
      }
    }
  }
}
